FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
SECRET_KEY=change-me

# Database (MySQL via PyMySQL)
DATABASE_URL=mysql+pymysql://root:@localhost/plant-fyp
SQL_ECHO=0

# Inference engine: torch (full), onnx (lite, needs models/onnx/) or auto (torch if installed)
GREENMIND_ENGINE=auto
# ORT_THREADS=1

# Species classifier. Leave these unset to use the retrained EfficientNet-B0 automatically when
# models/checkpoints/plant_id_effb0_best.pth and models/class_maps/idx_to_species_effb0.json exist
# (otherwise the original ResNet-18 is used). To force the original model:
# MODEL_NAME=resnet18
# CKPT_PATH=models/checkpoints/plant_id_resnet18_best.pth
# IDX2_PATH=models/class_maps/idx_to_species.json

# Disease classifier (input size must match the size used in training)
# auto = hybrid (leaf crops) when the leaf detector is present, otherwise classifier
HEALTH_MODE=auto
# Leave HEALTH_CLF_WEIGHTS unset to use models/health/leaf_health_effb0_field.pth when present
# HEALTH_CLF_WEIGHTS=models/health/leaf_health_effb3.pt
HEALTH_ARCH=efficientnet_b0
HEALTH_CLASSES=models/health/classes.json
HEALTH_INPUT_SIZE=224

# Placeholders only - do NOT put real keys here
OPENAI_API_KEY=YOUR_OPENAI_KEY_HERE
PLANT_ID_API_KEY=
PLANTNET_API_KEY=
OPENWEATHER_API_KEY=
