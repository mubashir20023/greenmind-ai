FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
SECRET_KEY=change-me

# Database (MySQL via PyMySQL)
DATABASE_URL=mysql+pymysql://root:@localhost/plant-fyp
SQL_ECHO=0

# Species classifier
MODEL_NAME=resnet18
CKPT_PATH=models/checkpoints/plant_id_resnet18_best.pth
IDX2_PATH=models/class_maps/idx_to_species.json

# Disease classifier (input size must match the size used in training)
HEALTH_MODE=classifier
HEALTH_CLF_WEIGHTS=models/health/leaf_health_effb3.pt
HEALTH_CLASSES=models/health/classes.json
HEALTH_INPUT_SIZE=224

# Placeholders only - do NOT put real keys here
OPENAI_API_KEY=YOUR_OPENAI_KEY_HERE
PLANT_ID_API_KEY=
PLANTNET_API_KEY=
OPENWEATHER_API_KEY=
